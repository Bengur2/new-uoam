<Window x:Class="NewUOAM.App.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aktualizace new UOAM" Width="460" Height="380" MinWidth="360" MinHeight="300"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#FF1E1E1E">
    <!-- Offered at startup when the feed has a newer version, or from Mapa > Zkontrolovat
         aktualizace (MainWindow.Updates.cs). Download, verification and the file swap run here so
         an error shows in this window and the map keeps running. -->
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Je dostupná nová verze mapy" Foreground="White" FontSize="15" FontWeight="SemiBold"/>
        <TextBlock Grid.Row="1" x:Name="VersionText" Foreground="#FFBBBBBB" Margin="0,4,0,8"/>
        <TextBox Grid.Row="2" x:Name="NotesTextBox" IsReadOnly="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" Background="#FF2A2A2A" Foreground="White"
                 BorderBrush="#FF3C3C3C" Padding="6,4"/>
        <TextBlock Grid.Row="3" Foreground="#FF9AD29A" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"
                   Text="Tvoje markery i nastavení zůstanou, jak jsou. Mapa se po aktualizaci sama znovu spustí."/>
        <StackPanel Grid.Row="4" Margin="0,8,0,0">
            <ProgressBar x:Name="DownloadProgress" Height="10" Minimum="0" Maximum="1" Visibility="Collapsed"/>
            <TextBlock x:Name="StatusLine" Foreground="#FFBBBBBB" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed"/>
        </StackPanel>
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="UpdateButton" Content="Aktualizovat" Width="110" Padding="0,3" IsDefault="True" Click="UpdateButton_Click"/>
            <Button x:Name="LaterButton" Content="Později" Width="90" Padding="0,3" Margin="8,0,0,0" Click="LaterButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
