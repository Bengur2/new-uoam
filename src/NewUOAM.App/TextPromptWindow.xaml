<Window x:Class="NewUOAM.App.TextPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="300" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#FF1E1E1E">
    <!-- One line of text, e.g. a new marker category's name. Title, label and validation come
         from the caller. -->
    <StackPanel Margin="14">
        <TextBlock x:Name="PromptText" Foreground="White" Margin="0,0,0,2" TextWrapping="Wrap"/>
        <TextBox x:Name="InputTextBox" Padding="4,3" Margin="0,0,0,10" MaxLength="40" TextChanged="InputTextBox_TextChanged"/>

        <TextBlock x:Name="ErrorText" Foreground="#FFFF7070" FontSize="11" TextWrapping="Wrap"
                   Margin="0,0,0,8" Visibility="Collapsed"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="OK" Width="80" Padding="0,3" IsDefault="True" Click="OkButton_Click"/>
            <Button Content="{DynamicResource Cr_Cancel}" Width="80" Padding="0,3" Margin="8,0,0,0" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
