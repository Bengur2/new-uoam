<Window x:Class="NewUOAM.App.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="new UOAM - Admin místností" Height="680" Width="600" MinWidth="460" MinHeight="480"
        Background="#FF1E1E1E">
    <!-- Room admin (2026-10-01 rework): the room list with source and dates (never passwords or
         players), multi-select delete, the switch for player room creation, and creating an
         admin room with a chosen password. -->
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="ADMIN MÍSTNOSTÍ" Foreground="White" FontWeight="Bold" FontSize="15" Margin="0,0,0,12"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Adresa relay serveru (host:port)" Foreground="Gray" FontSize="11" Margin="0,0,0,2"/>
                    <TextBox x:Name="ServerAddressTextBox" Padding="4,4"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Admin heslo" Foreground="Gray" FontSize="11" Margin="0,0,0,2"/>
                    <PasswordBox x:Name="AdminPasswordBox" Padding="4,4" KeyDown="AdminPasswordBox_KeyDown"/>
                </StackPanel>
            </Grid>
        </StackPanel>

        <Border Grid.Row="1" Background="#FF252528" BorderBrush="#FF3F3F46" BorderThickness="1" Padding="10,8" Margin="0,12,0,0">
            <StackPanel>
                <CheckBox x:Name="PlayerCreationCheckBox" Content="Hráči si můžou zakládat místnosti" Foreground="White"
                          IsEnabled="False" Click="PlayerCreationCheckBox_Click"/>
                <TextBlock x:Name="PlayerCreationInfo" Foreground="#FF9A9A9A" FontSize="11" TextWrapping="Wrap" Margin="20,2,0,0"
                           Text="Načti seznam (Obnovit). Při spamu zakládání vypni a spam smaž."/>
            </StackPanel>
        </Border>

        <DockPanel Grid.Row="2" Margin="0,14,0,6" LastChildFill="False">
            <TextBlock Text="MÍSTNOSTI" Foreground="#FF9A9A9A" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
            <Button x:Name="RefreshRoomsButton" Content="⟳ Obnovit" Padding="8,2" Margin="10,0,0,0" Click="RefreshRoomsButton_Click"/>
            <Button x:Name="SelectRecentButton" DockPanel.Dock="Right" Content="Vybrat hráčské za posledních 24 h" Padding="8,2"
                    IsEnabled="False" Click="SelectRecentButton_Click"/>
        </DockPanel>

        <Border Grid.Row="3" BorderBrush="#FF3F3F46" BorderThickness="1">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Background="#FF2D2D30">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="110"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Název" Foreground="#FF9A9A9A" FontSize="11" Margin="8,4"/>
                    <TextBlock Grid.Column="1" Text="Založil" Foreground="#FF9A9A9A" FontSize="11" Margin="4,4"/>
                    <TextBlock Grid.Column="2" Text="Založeno" Foreground="#FF9A9A9A" FontSize="11" Margin="4,4"/>
                    <TextBlock Grid.Column="3" Text="Naposledy použita" Foreground="#FF9A9A9A" FontSize="11" Margin="4,4"/>
                </Grid>
                <ListBox x:Name="RoomsListBox" SelectionMode="Extended" Background="#FF1E1E1E" BorderThickness="0"
                         HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True" SelectionChanged="RoomsListBox_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="White" TextTrimming="CharacterEllipsis" Margin="4,1"/>
                                <TextBlock Grid.Column="1" Text="{Binding Source}" Foreground="{Binding SourceBrush}" Margin="4,1"/>
                                <TextBlock Grid.Column="2" Text="{Binding Created}" Foreground="#FFBBBBBB" Margin="4,1"/>
                                <TextBlock Grid.Column="3" Text="{Binding LastUsed}" Foreground="#FFBBBBBB" Margin="4,1"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,8,0,0">
            <Button x:Name="DeleteRoomButton" Content="Smazat vybrané" Padding="8,3" IsEnabled="False" Click="DeleteRoomButton_Click"/>
            <TextBlock Foreground="#FF9A9A9A" FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0"
                       Text="Ctrl / Shift + klik vybere víc místností."/>
        </StackPanel>

        <StackPanel Grid.Row="5">
            <Expander Header="Nová místnost s vlastním heslem (admin)" Foreground="White" Margin="0,12,0,0">
                <StackPanel Margin="0,8,0,0">
                    <TextBlock Text="Jméno místnosti" Foreground="Gray" FontSize="11" Margin="0,0,0,2"/>
                    <TextBox x:Name="NewRoomNameTextBox" Padding="4,4" Margin="0,0,0,6"/>
                    <TextBlock Text="Heslo místnosti" Foreground="Gray" FontSize="11" Margin="0,0,0,2"/>
                    <TextBox x:Name="NewRoomPasswordTextBox" Padding="4,4" Margin="0,0,0,8"/>
                    <Button x:Name="CreateRoomButton" Content="Vytvořit místnost" Padding="8,3" HorizontalAlignment="Left"
                            Click="CreateRoomButton_Click"/>
                </StackPanel>
            </Expander>
            <TextBlock x:Name="StatusTextBlock" Foreground="#FFCCCCCC" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</Window>
