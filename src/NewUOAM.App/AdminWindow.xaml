<Window x:Class="NewUOAM.App.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="new UOAM - Admin místností" Height="480" Width="380"
        Background="#FF1E1E1E">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="16">
            <TextBlock Text="ADMIN MÍSTNOSTÍ" Foreground="White" FontWeight="Bold" FontSize="15" Margin="0,0,0,12"/>

            <TextBlock Text="Adresa relay serveru (host:port)" Foreground="Gray" FontSize="11" Margin="0,0,0,2"/>
            <TextBox x:Name="ServerAddressTextBox" Padding="4,4" Margin="0,0,0,8"/>
            <TextBlock Text="Admin heslo" Foreground="Gray" FontSize="11" Margin="0,0,0,2"/>
            <PasswordBox x:Name="AdminPasswordBox" Padding="4,4" Margin="0,0,0,10"/>

            <Separator Margin="0,4,0,12" Background="#FF3F3F46"/>

            <TextBlock Text="NOVÁ MÍSTNOST" Foreground="#FF9A9A9A" FontWeight="Bold" FontSize="11" Margin="0,0,0,6"/>
            <TextBlock Text="Jméno místnosti" Foreground="Gray" FontSize="11" Margin="0,0,0,2"/>
            <TextBox x:Name="NewRoomNameTextBox" Padding="4,4" Margin="0,0,0,6"/>
            <TextBlock Text="Heslo místnosti" Foreground="Gray" FontSize="11" Margin="0,0,0,2"/>
            <TextBox x:Name="NewRoomPasswordTextBox" Padding="4,4" Margin="0,0,0,8"/>
            <Button x:Name="CreateRoomButton" Content="Vytvořit místnost" Padding="8,3" HorizontalAlignment="Left"
                    Click="CreateRoomButton_Click"/>

            <Separator Margin="0,16,0,12" Background="#FF3F3F46"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="EXISTUJÍCÍ MÍSTNOSTI" Foreground="#FF9A9A9A" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                <Button x:Name="RefreshRoomsButton" Content="⟳ Obnovit" Padding="8,2" Margin="10,0,0,0" Click="RefreshRoomsButton_Click"/>
            </StackPanel>
            <ListBox x:Name="RoomsListBox" Height="150" Background="#FF2D2D30" Foreground="White" BorderBrush="#FF3F3F46"
                     SelectionChanged="RoomsListBox_SelectionChanged"/>
            <Button x:Name="DeleteRoomButton" Content="Smazat vybranou místnost" Padding="8,3" Margin="0,8,0,0"
                    HorizontalAlignment="Left" IsEnabled="False" Click="DeleteRoomButton_Click"/>

            <TextBlock x:Name="StatusTextBlock" Foreground="#FFCCCCCC" FontSize="11" Margin="0,12,0,0" TextWrapping="Wrap"/>
        </StackPanel>
    </ScrollViewer>
</Window>
