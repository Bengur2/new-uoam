<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\NewUOAM.MapData\NewUOAM.MapData.csproj" />
    <ProjectReference Include="..\NewUOAM.Positioning\NewUOAM.Positioning.csproj" />
    <ProjectReference Include="..\NewUOAM.Updates\NewUOAM.Updates.csproj" />
    <!-- In-game command bridge (a separate exe). Referenced only so its files land next to the
         app; the app copies them to %LocalAppData% and runs the copy (see UoAssistCommands). -->
    <ProjectReference Include="..\NewUOAM.UoaBridge\NewUOAM.UoaBridge.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- UOAM/Orion-compatible marker icon set (see MainWindow's marker overlay) - plain files
         copied next to the exe, loaded by path at runtime like everything else this app reads
         from disk, rather than compiled in as WPF pack resources. -->
    <Content Include="Assets\MapIcons\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- The released version (Mapa > Zkontrolovat aktualizace compares it with the feed). Bump
         it for every release - see docs/RELEASE.md. -->
    <Version>1.0.3</Version>
    <!-- Exe, window and installer icon (drawn by tools\Release\make-icon.ps1). -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

</Project>
