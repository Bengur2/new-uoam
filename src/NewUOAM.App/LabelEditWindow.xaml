<Window x:Class="NewUOAM.App.LabelEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Label" Width="300" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#FF1E1E1E">
    <!-- Old UOAM's "Edit Label" dialog (same window for a new label and for editing one), minus
         its Latitude/Longitude button. -->
    <StackPanel Margin="14">
        <TextBlock Text="Name:" Foreground="White" Margin="0,0,0,2"/>
        <TextBox x:Name="NameTextBox" Padding="4,3" Margin="0,0,0,10" MaxLength="100"
                 TextChanged="Input_Changed"/>

        <TextBlock Text="Type:" Foreground="White" Margin="0,0,0,2"/>
        <ComboBox x:Name="IconComboBox" Padding="4,3" Margin="0,0,0,10" MaxDropDownHeight="360">
            <ComboBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel/>
                </ItemsPanelTemplate>
            </ComboBox.ItemsPanel>
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{Binding Image, Mode=OneTime}" Width="20" Height="20" Margin="0,0,8,0"
                               RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                        <TextBlock Text="{Binding Name, Mode=OneTime}" VerticalAlignment="Center"/>
                    </StackPanel>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <!-- Not in old UOAM: your own marker categories (MarkerCategoryStore). Empty = the
             category the icon gives; a new name creates the category. -->
        <TextBlock Text="Category:" Foreground="White" Margin="0,0,0,2"/>
        <ComboBox x:Name="CategoryComboBox" IsEditable="True" Padding="4,3" Margin="0,0,0,2"/>
        <TextBlock Text="(empty = by icon; a new name creates a category)" Foreground="Gray" FontSize="11"
                   TextWrapping="Wrap" Margin="0,0,0,10"/>

        <TextBlock Text="Position:" Foreground="White" Margin="0,0,0,2"/>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="X:" Foreground="White" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <TextBox x:Name="XTextBox" Width="60" Padding="4,3" TextChanged="Input_Changed"/>
            <TextBlock Text="Y:" Foreground="White" VerticalAlignment="Center" Margin="12,0,4,0"/>
            <TextBox x:Name="YTextBox" Width="60" Padding="4,3" TextChanged="Input_Changed"/>
        </StackPanel>

        <TextBlock Text="Land:" Foreground="White" Margin="0,0,0,2"/>
        <ComboBox x:Name="LandComboBox" Padding="4,3" Margin="0,0,0,10" DisplayMemberPath="Name"
                  SelectionChanged="Input_Changed"/>

        <TextBlock Text="File:" Foreground="White" Margin="0,0,0,2"/>
        <ComboBox x:Name="FileComboBox" Padding="4,3" Margin="0,0,0,10" DisplayMemberPath="Display"/>

        <TextBlock x:Name="ErrorText" Foreground="#FFFF7070" FontSize="11" TextWrapping="Wrap"
                   Margin="0,0,0,8" Visibility="Collapsed"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="OkButton" Content="OK" Width="80" Padding="0,3" IsDefault="True" Click="OkButton_Click"/>
            <Button Content="Cancel" Width="80" Padding="0,3" Margin="8,0,0,0" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
