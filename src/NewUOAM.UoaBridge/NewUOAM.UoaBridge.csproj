<Project Sdk="Microsoft.NET.Sdk">

  <!-- Deliberately dependency-free and tiny: one instance runs per UO client for as long as that
       client runs (see Program.cs for why), so it must rarely need to change. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
